131// 2. Cyberpunk Retro-Futurista Mode
132 vec3 renderCyberpunk(vec2 st, vec2 uvRaw) {
133   tiempo flotante = uTime * 1.2;
134   vec2 p = st;
135
136   // Líneas de escaneo con fallos y distorsión de graves
137   float scanline = sin(uvRaw.y * 380.0 + time * 10.0) * 0.06;
138   px += sin(py * 30.0 + tiempo * 8.0) * 0.01 * uBass;
139
140   // Portal ecualizador de neón circular
141   float r = longitud(p);
142   float a = atan(py, px);
143   picos flotantes = sin(a * 16.0 + tiempo * 2.0) * uBass * 0.08;
144   float circ1 = smoothstep(0.015 + uHighs * 0.02, 0.0, abs(r - (0.35 + spikes)));
145   float circ2 = smoothstep(0.01, 0.0, abs(r - (0.55 + sin(a * 24.0 - time * 3.0) * uMids * 0.06)));
146
147   // Piso de la Red Cibernética
148   float floorY = py + 0.35;
149   vec3 gridCol = vec3(0.0);
150   si (floorY < 0.0) {
151     vec2 gridUv = vec2(px / (-floorY), 1.0 / (-floorY) + tiempo * 1.5);
152     float linesX = smoothstep(0.08, 0.0, abs(fract(gridUv.x * 3.0) - 0.5));
153     float linesZ = smoothstep(0.08, 0.0, abs(fract(gridUv.y * 2.0) - 0.5));
154     float grid = max(linesX, linesZ) * smoothstep(2.5, 0.0, length(p));
155     gridCol = vec3(0.0, 0.8, 1.0) * grid * (0.4 + uBass * 0.8);
156   }
157
158   // Silueta del horizonte de la ciudad en neón
159   float bldX = abs(px * 2.2);
160   float bldHeight = noise(vec2(floor(bldX * 6.0), 1.2)) * 0.45;
161   float enEdificio = paso(py + 0.35, alturaBld) * paso(0.0, py + 0.35);
162   vec3 bldCol = vec3(0.02, 0.01, 0.05);
163   si (enEdificio > 0.5) {
164     float windows = step(0.85, hash21(floor(vec2(px * 40.0, py * 50.0)))) * uMids;
165     bldCol = mix(vec3(0.05, 0.02, 0.08), vec3(1.0, 0.9, 0.3), windows);
166   }
167
168   // Mapeo de color: cian neón y magenta intenso
169   vec3 cian = vec3(0.0, 0.95, 1.0);
170   vec3 magenta = vec3(1.0, 0.05, 0.65);
171   vec3 neonRings = cyan * circ1 * 1.8 + magenta * circ2 * 1.6;
172
173   vec3 bg = mix(vec3(0.02, 0.01, 0.04), vec3(0.12, 0.02, 0.18), uvRaw.y);
174   vec3 col = bg + gridCol + neonRings;
175   si (enEdificio > 0.5) col = mix(col, bldCol, 0.85);
176
177   // Aberración cromática RGB en el ritmo
178   float split = uBass * 0.025;
179   col.r += noise(st + vec2(split, 0.0)) * 0.12 * uBass;
180   col.b += noise(st - vec2(split, 0.0)) * 0.15 * uBass;
181
182   col -= línea de exploración;
183   columna de retorno;
184 }
