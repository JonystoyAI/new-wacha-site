186 // 3. Synthwave de los 80 (Outrun Retro Horizon)
187 vec3 renderSynthwave(vec2 st, vec2 uvRaw) {
188   float tiempo = uTime * 1.0;
189   vec2 p = st;
190
191   // Sol gigante retro
192   vec2 sunPos = vec2(0.0, 0.15);
193   float sunDist = length(p - sunPos);
194   sol flotante = paso suave (0,38, 0,36, distsol);
195
196   // Barras horizontales con recorte para el sol
197  if (p.y < sunPos.y + 0.38 && p.y > sunPos.y - 0.38) {
198    float bar = sin((p.y - sunPos.y) * 45.0 + time * 1.5);
199     float cutProg = (sunPos.y + 0.38 - py) / 0.76;
200     si (barra > 0.4 - cutProg * 0.6) {
201       soles = 0,0;
202     }
203   }
204
205   // Degradado solar (de amarillo a rosa intenso)
206  float sunGrad = clamp((p.y - (sunPos.y - 0.35)) / 0.7, 0.0, 1.0);
207   vec3 sunColor = mix(vec3(1.0, 0.05, 0.5), vec3(1.0, 0.95, 0.2), sunGrad) * (1.0 + uBass * 0.4);
208
209   // Cuadrícula de perspectiva de los años 80
210   float horizon = -0.05;
211   vec3 gridColor = vec3(0.0);
212   si (py < horizonte) {
213     float profundidad = 1.0 / (horizonte - py);
214     vec2 gridCoord = vec2(px * profundidad * 0.7, profundidad + tiempo * 4.0);
215
216     float lineX = smoothstep(0.06, 0.0, abs(fract(gridCoord.x) - 0.5));
217     float lineZ = smoothstep(0.06, 0.0, abs(fract(gridCoord.y) - 0.5));
218     float gridMask = max(lineX, lineZ) * smoothstep(horizon - 0.8, horizon, py);
219
220     // Rejilla de color púrpura neón/cian con pulsación de graves
221     gridColor = mix(vec3(0.85, 0.1, 0.9), vec3(0.1, 0.85, 1.0), sin(gridCoord.x * 2.0) * 0.5 + 0.5);
222     gridColor *= gridMask * (1.2 + uBass * 1.2);
223   }
224
225   // Gradiente del cielo y estrellas
226   vec3 sky = mix(vec3(0.03, 0.0, 0.08), vec3(0.35, 0.05, 0.35), clamp(py + 0.4, 0.0, 1.0));
227   si (py > horizonte && sol < 0.1) {
228     float stars = step(0.985, hash21(floor(p * 90.0)));
229     cielo += vec3(0.9, 0.9, 1.0) * estrellas * (0.4 + uHighs * 0.6);
230   }
231
232   vec3 col = cielo;
233   col = mix(col, sunColor, sun);
234  col += gridColor;
235
236   // Líneas de escaneo CRT y brillo sutil
237   float crt = sin(uvRaw.y * 360.0) * 0.05;
238   col -= crt;
239   col += vec3(0.12, 0.0, 0.15) * uBass;
240
241   columna de retorno;
242 }
