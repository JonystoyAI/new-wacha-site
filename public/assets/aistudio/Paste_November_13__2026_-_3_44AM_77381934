    function handleLogoUpload(event, type) {
      const file = event.target.files[0];
      const assetId = document.getElementById('ed-id').value;
      if (!file || !assetId) return;

      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const current = logosCache[assetId] || { png: null, svg: null };
          if (type === 'png') {
            await saveLogoToIDB(assetId, e.target.result, current.svg);
            showToast('Archivo PNG guardado en IndexedDB');
          } else {
            const cleanSvg = sanitizeSvgMarkup(e.target.result);
            await saveLogoToIDB(assetId, current.png, cleanSvg);
            showToast('Archivo SVG sanitizado y guardado en IndexedDB');
          }
          refreshEditorLogoPreviews(assetId);
          renderWorkspace();
        } catch (err) {
          showToast(`Error: ${err.message}`, 'error');
        }
        event.target.value = '';
      };
      if (type === 'png') reader.readAsDataURL(file);
      else reader.readAsText(file);
    }

