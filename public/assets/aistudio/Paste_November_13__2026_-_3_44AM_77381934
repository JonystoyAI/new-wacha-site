        ...item,
        vertical: targetVertical,
        socialMain: item.socialMain || { platform: targetVertical === 'musica_audio' ? 'Bandcamp' : 'YouTube', url: '' },
        socialSecondary: Array.isArray(item.socialSecondary) ? item.socialSecondary : [],
