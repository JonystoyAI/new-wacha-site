    function handleImportFullBackup(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          const importedAssets = Array.isArray(parsed) ? parsed : parsed.assets;
          if (!Array.isArray(importedAssets)) throw new Error('Archivo JSON no válido.');
          assets = importedAssets;
          saveAssets();

          if (parsed.binaryLogos && typeof parsed.binaryLogos === 'object') {
            for (const [assetId, logoObj] of Object.entries(parsed.binaryLogos)) {
              await saveLogoToIDB(assetId, logoObj.png || null, logoObj.svg || null);
            }
          }
          renderWorkspace();
          showToast(`Respaldo restaurado (${assets.length} fichas)`);
        } catch (err) {
          showToast(`Error al importar: ${err.message}`, 'error');
        }
        event.target.value = '';
      };
      reader.readAsText(file);
    }

