          type: 'Prompt',
          usedFor: item.func || 'Guionización',
          projects: [item.name],
          aiModel: (item.aiTools && item.aiTools[0]) || 'Gemini 2.5 Pro'
        }
      };

      // Ajustar valores por defecto inteligentes si el destino es INDICADORES o MÚSICA
      if (targetVertical === 'indicadores') {
        if (!migrated.indicatorMeta.projects || migrated.indicatorMeta.projects.length === 0) {
          migrated.indicatorMeta.projects = ['Transversal / Todos'];
        }
        if (!migrated.indicatorMeta.usedFor) {
          migrated.indicatorMeta.usedFor = migrated.func || 'Investigación Forense';
        }
      } else if (targetVertical === 'musica_audio') {
        migrated.func = 'Masterización Audio';
      }

      assets[idx] = migrated;
      saveAssets();
      renderWorkspace();

      if (reopenEditor) {
        openEditorModal(assetId);
      }

      showUndoToast(
        `Movido "${migrated.name}" → ${VERTICAL_NAMES[targetVertical]}`,
        () => undoLastMove()
      );
    }

    function undoLastMove() {
      if (!lastMoveSnapshot) return;
      const idx = assets.findIndex(a => a.id === lastMoveSnapshot.assetId);
      if (idx !== -1) {
        assets[idx] = lastMoveSnapshot.previousState;
        saveAssets();
        renderWorkspace();
        if (!document.getElementById('modal-editor').classList.contains('hidden')) {
          openEditorModal(lastMoveSnapshot.assetId);
        }
        showToast(`Movimiento deshecho: restaurado en ${lastMoveSnapshot.fromLabel}`);
      }
      lastMoveSnapshot = null;
    }

