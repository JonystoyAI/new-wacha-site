    function openFastCaptureModal() {
      document.getElementById('fc-name').value = '';
      if (currentVertical !== 'all') {
        document.getElementById('fc-vertical').value = currentVertical;
      }
      toggleFastCaptureIndicatorFields();
      openModal('modal-fast-capture');
      setTimeout(() => document.getElementById('fc-name').focus(), 40);
    }

    function submitFastCapture(e) {
      e.preventDefault();
      const name = document.getElementById('fc-name').value.trim();
      const vertical = document.getElementById('fc-vertical').value;
      const func = document.getElementById('fc-function').value.trim() || 'Guionización';
      const ownership = document.getElementById('fc-ownership').value;
      const indType = document.getElementById('fc-ind-type').value;
      const indModel = document.getElementById('fc-ind-model').value.trim() || 'Gemini 2.5 Pro';
      if (!name) return;

      const newItem = {
        id: 'asset-' + Date.now(),
        vertical,
        name,
        func,
        status: 'Activo',
        visibility: 'privado',
        ownership,
        tags: [`#${vertical}`],
        googleAccount: '',
        regPhone: '',
        socialMain: { platform: vertical === 'musica_audio' ? 'Bandcamp' : 'YouTube', url: '' },
        socialSecondary: [],
        voiceId: '',
        voiceParams: '',
        aiTools: [indModel],
        palette: ['#0B0E14', '#14B8A6'],
        fontPrimary: '',
        fontSecondary: '',
        fontBody: '',
        brandElements: '',
        brandStyle: '',
        stylelock: '',
        prompt: '',
        links: { drive: '', terabox: '', other: '' },
        contact: { name: '', phone: '' },
        ads: { phone: '', line1: '', line2: '', whatsapp: '', addr1: '', addr2: '' },
        infra: { website: '', hosting: '', domainProvider: '', renewal: '', regAccount: '', siteNotes: '', cloudServices: [] },
        audioSpec: { album: '', bpm: '', lufs: '', chain: '' },
        indicatorMeta: {
          type: indType,
          usedFor: func,
          projects: vertical === 'indicadores' ? ['Transversal / Todos'] : [name],
          aiModel: indModel
        },
        blogGuide: '',
        privateNotes: ''
      };

      assets.unshift(newItem);
      saveAssets();
      closeModal('modal-fast-capture');
      renderWorkspace();
      openEditorModal(newItem.id);
      showToast(`Ficha "${name}" creada en ${VERTICAL_NAMES[vertical]}`);
    }

    // ==========================================================================
    // 7. EDITOR INTEGRAL CON SUB-PESTAÑAS Y "MOVER A: ___"
    // ==========================================================================
    function switchEditorTab(tabKey) {
      ['general', 'indicador', 'brand', 'ads_crm', 'infra', 'audio_style'].forEach(k => {
        const pane = document.getElementById(`ed-pane-${k}`);
        const btn = document.getElementById(`ed-tab-${k}`);
        if (k === tabKey) {
          pane.classList.remove('hidden');
          btn.classList.add('bg-panel', 'border-borderTech', 'text-amberSurgical');
          btn.classList.remove('bg-transparent', 'border-transparent', 'text-slate-400');
        } else {
          pane.classList.add('hidden');
          btn.classList.remove('bg-panel', 'border-borderTech', 'text-amberSurgical');
          btn.classList.add('bg-transparent', 'border-transparent', 'text-slate-400');
        }
      });
    }

    function openEditorModal(id) {
      const item = assets.find(a => a.id === id);
      if (!item) return;

      document.getElementById('ed-id').value = item.id;
      document.getElementById('ed-title').textContent = item.name;
      document.getElementById('ed-move-vertical').value = item.vertical;

      document.getElementById('ed-name').value = item.name || '';
      document.getElementById('ed-status').value = item.status || 'Activo';
      document.getElementById('ed-visibility').value = item.visibility || 'privado';
      document.getElementById('ed-function').value = item.func || '';
      document.getElementById('ed-tags').value = (item.tags || []).join(', ');

      // Cuentas y Redes
      document.getElementById('ed-google-account').value = item.googleAccount || '';
      document.getElementById('ed-reg-phone').value = item.regPhone || '';
      const sMain = item.socialMain || { platform: 'YouTube', url: '' };
      document.getElementById('ed-social-main-platform').value = sMain.platform || 'YouTube';
      document.getElementById('ed-social-main-url').value = sMain.url || '';
      editorSocialSecondary = JSON.parse(JSON.stringify(item.socialSecondary || []));
      renderSocialSecondaryRows();

      document.getElementById('ed-voice-id').value = item.voiceId || '';
      document.getElementById('ed-voice-params').value = item.voiceParams || '';
      editorAiTools = [...(item.aiTools || [])];
      renderAiToolsChips();

      // Indicador IA
      const im = item.indicatorMeta || { type: 'Prompt', usedFor: item.func || '', projects: [], aiModel: 'Gemini 2.5 Pro' };
      document.getElementById('ed-ind-type').value = im.type || 'Prompt';
