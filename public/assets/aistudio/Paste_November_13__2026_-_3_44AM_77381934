<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NEXUS STUDIO OS v3.0 — CreativeOps, DAM & Indicadores IA</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: '#0B0E14',
            panel: '#121722',
            elevated: '#1A2130',
            borderTech: '#232D3F',
            tealSurgical: '#14B8A6',
            amberSurgical: '#F59E0B',
            violetInd: '#8B5CF6',
            roseAudio: '#F43F5E',
            emeraldOk: '#10B981',
            crimsonAlert: '#EF4444'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          }
        }
      }
    }
  </script>

  <style>
    * { box-sizing: border-box; }
    body {
      background-color: #0B0E14;
      color: #E2E8F0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0B0E14; }
    ::-webkit-scrollbar-thumb { background: #232D3F; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #374561; }

    .studio-grid {
      background-image:
        linear-gradient(to right, rgba(35, 45, 63, 0.35) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(35, 45, 63, 0.35) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    .checkerboard-bg {
      background-color: #182030;
      background-image:
        linear-gradient(45deg, #232D3F 25%, transparent 25%),
        linear-gradient(-45deg, #232D3F 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #232D3F 75%),
        linear-gradient(-45deg, transparent 75%, #232D3F 75%);
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    }

    .var-token {
      color: #F59E0B;
      background-color: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.4);
      padding: 1px 5px;
      border-radius: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85em;
      font-weight: 600;
    }

    .modal-backdrop {
      background-color: rgba(5, 7, 11, 0.86);
      backdrop-filter: blur(6px);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-tealSurgical/25 selection:text-tealSurgical">

  <!-- ======================================================================== -->
  <!-- TOPBAR DE CONSOLA DE ESTUDIO                                             -->
  <!-- ======================================================================== -->
  <header class="sticky top-0 z-30 bg-obsidian/95 backdrop-blur-md border-b border-borderTech px-4 lg:px-6 py-3">
    <div class="max-w-[1680px] mx-auto flex flex-wrap items-center justify-between gap-3">
      
      <!-- Identidad & Estado de Persistencia Híbrida -->
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-panel border border-borderTech flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-tealSurgical/20 via-transparent to-amberSurgical/20"></div>
          <svg class="w-5 h-5 text-tealSurgical relative z-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-white">NEXUS STUDIO OS <span class="text-amberSurgical">v3.0</span></h1>
            <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-panel border border-borderTech text-tealSurgical">
              CREATIVEOPS • DAM • INDICADORES IA
            </span>
          </div>
          <div class="flex items-center gap-2 mt-0.5 text-[11px] font-mono">
            <span id="sync-dot" class="w-2 h-2 rounded-full bg-emeraldOk"></span>
            <span id="sync-label" class="text-slate-400">LS + IndexedDB Sincronizado</span>
            <span class="text-slate-600">•</span>
            <span id="total-assets-count" class="text-slate-200">0 fichas</span>
            <span class="text-slate-600 hidden sm:inline">•</span>
            <span id="idb-logos-count" class="text-tealSurgical hidden sm:inline">0 logos binarios</span>
          </div>
        </div>
      </div>

      <!-- Controles Globales -->
      <div class="flex flex-wrap items-center gap-2">
        <input type="file" id="import-json-input" accept=".json" class="hidden" onchange="handleImportFullBackup(event)" />

        <button onclick="document.getElementById('import-json-input').click()" title="Importar respaldo completo (.json con logos PNG/SVG)"
                class="px-3 py-2 rounded-lg bg-panel hover:bg-elevated border border-borderTech text-xs font-medium text-slate-300 flex items-center gap-1.5 transition">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span class="hidden sm:inline">Importar Respaldo (.json)</span>
          <span class="sm:hidden">Importar</span>
        </button>

        <button onclick="exportFullBackup()" title="Exportar respaldo completo (.json incluyendo logos binarios)"
                class="px-3 py-2 rounded-lg bg-panel hover:bg-elevated border border-borderTech text-xs font-medium text-slate-300 flex items-center gap-1.5 transition">
          <svg class="w-3.5 h-3.5 text-tealSurgical" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="hidden sm:inline">Exportar Respaldo (.json)</span>
          <span class="sm:hidden">Respaldo</span>
        </button>

        <button onclick="openBlogHubModal()" title="Exportador Sanitizado para Blog"
                class="px-3 py-2 rounded-lg bg-emeraldOk/10 hover:bg-emeraldOk/20 border border-emeraldOk/30 text-xs font-semibold text-emeraldOk flex items-center gap-1.5 transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span>Modo Blog</span>
        </button>

        <button onclick="openFastCaptureModal()"
                class="px-3.5 py-2 rounded-lg bg-amberSurgical hover:bg-amber-400 text-obsidian text-xs font-extrabold flex items-center gap-1.5 shadow-sm transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>+ Captura Rápida</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ======================================================================== -->
  <!-- 4 VERTICALES CLARAS Y SIN RUIDO + BUSCADOR GLOBAL Y FILTROS CRUZADOS      -->
  <!-- ======================================================================== -->
  <section class="studio-grid border-b border-borderTech bg-panel/70 px-4 lg:px-6 py-4">
    <div class="max-w-[1680px] mx-auto space-y-3.5">
      
      <!-- Pestañas de las 4 Verticales Independientes -->
      <div class="flex flex-wrap items-center gap-2" id="vertical-tabs">
        <button onclick="setFilterVertical('all')" data-v="all"
                class="v-tab px-3.5 py-2 rounded-lg text-xs font-bold border transition flex items-center gap-2">
          <span>Todas las Verticales</span>
          <span class="v-count font-mono text-[11px] px-1.5 py-0.2 rounded bg-obsidian/80">0</span>
        </button>
        <button onclick="setFilterVertical('canales')" data-v="canales"
                class="v-tab px-3.5 py-2 rounded-lg text-xs font-bold border transition flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-tealSurgical"></span>
          <span>1. Canales de Contenido</span>
          <span class="v-count font-mono text-[11px] px-1.5 py-0.2 rounded bg-obsidian/80">0</span>
        </button>
        <button onclick="setFilterVertical('clientes')" data-v="clientes"
                class="v-tab px-3.5 py-2 rounded-lg text-xs font-bold border transition flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amberSurgical"></span>
          <span>2. Clientes, Diseño & Web</span>
          <span class="v-count font-mono text-[11px] px-1.5 py-0.2 rounded bg-obsidian/80">0</span>
        </button>
        <button onclick="setFilterVertical('musica_audio')" data-v="musica_audio"
                class="v-tab px-3.5 py-2 rounded-lg text-xs font-bold border transition flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-roseAudio"></span>
          <span>3. Música & Audio (Sonido Decrépito)</span>
          <span class="v-count font-mono text-[11px] px-1.5 py-0.2 rounded bg-obsidian/80">0</span>
        </button>
        <button onclick="setFilterVertical('indicadores')" data-v="indicadores"
                class="v-tab px-3.5 py-2 rounded-lg text-xs font-bold border transition flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-violetInd"></span>
          <span>4. INDICADORES (Códices, Skills, Habilidades & Prompts)</span>
          <span class="v-count font-mono text-[11px] px-1.5 py-0.2 rounded bg-obsidian/80">0</span>
        </button>
      </div>

      <!-- Barra de Búsqueda Global y Filtros Cruzados -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-2.5">
        <!-- Buscador Instantáneo -->
        <div class="md:col-span-4 relative">
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" id="global-search" oninput="renderWorkspace()"
                 placeholder="Buscar nombre, Voice ID, dominio, proyecto, modelo IA, HEX, red social..."
                 class="w-full pl-10 pr-8 py-2 rounded-lg bg-obsidian border border-borderTech focus:border-tealSurgical focus:outline-none text-xs text-white placeholder-slate-500" />
          <button id="clear-search-btn" onclick="clearSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs font-mono">
            ✕
          </button>
        </div>

        <!-- Filtro Tipo de Indicador -->
        <div class="md:col-span-2">
          <select id="filter-ind-type" onchange="renderWorkspace()"
                  class="w-full px-2.5 py-2 rounded-lg bg-obsidian border border-borderTech focus:border-violetInd focus:outline-none text-xs text-slate-200">
            <option value="all">Tipo Indicador: Todos</option>
            <option value="Códice">Códice</option>
            <option value="Skill">Skill</option>
            <option value="Habilidad">Habilidad</option>
            <option value="Prompt">Prompt</option>
          </select>
        </div>

        <!-- Filtro Función / Usado para -->
        <div class="md:col-span-2">
          <select id="filter-function" onchange="renderWorkspace()"
                  class="w-full px-2.5 py-2 rounded-lg bg-obsidian border border-borderTech focus:border-tealSurgical focus:outline-none text-xs text-slate-200">
            <option value="all">Función: Todas</option>
            <option value="Investigación Forense">Investigación Forense</option>
            <option value="Auditoría de Sesgos">Auditoría de Sesgos</option>
            <option value="Guionización">Guionización</option>
            <option value="Stylelock Visual">Stylelock Visual</option>
            <option value="Desarrollo Web / UI">Desarrollo Web / UI</option>
            <option value="Masterización Audio">Masterización Audio</option>
            <option value="Ciberseguridad">Ciberseguridad</option>
            <option value="SEO / Virales">SEO / Virales</option>
            <option value="Brand Kit & Diseño">Brand Kit & Diseño</option>
          </select>
        </div>

        <!-- Filtro Modelo de IA -->
        <div class="md:col-span-2">
          <select id="filter-ai-model" onchange="renderWorkspace()"
                  class="w-full px-2.5 py-2 rounded-lg bg-obsidian border border-borderTech focus:border-amberSurgical focus:outline-none text-xs text-slate-200">
            <option value="all">Modelo IA: Todos</option>
            <option value="Gemini 2.5 Pro">Gemini 2.5 Pro</option>
            <option value="DeepSeek R1 / 7B (Ollama)">DeepSeek R1 / 7B (Ollama)</option>
            <option value="Claude 3.7 Sonnet">Claude 3.7 Sonnet</option>
            <option value="GPT-4o">GPT-4o</option>
            <option value="Midjourney v6.1">Midjourney v6.1</option>
            <option value="Flux.1 Dev">Flux.1 Dev</option>
            <option value="ElevenLabs">ElevenLabs</option>
            <option value="Suno / Udio">Suno / Udio</option>
          </select>
        </div>

        <!-- Filtro Titularidad / Visibilidad + Reset -->
        <div class="md:col-span-2 flex gap-1.5">
          <select id="filter-ownership" onchange="renderWorkspace()"
                  class="w-full px-2.5 py-2 rounded-lg bg-obsidian border border-borderTech focus:border-tealSurgical focus:outline-none text-xs text-slate-200">
            <option value="all">Titular / Blog: Todos</option>
            <option value="owner_mio">🔑 Propiedad Mía</option>
            <option value="owner_cliente">🤝 Propiedad Cliente</option>
            <option value="vis_publico">🌐 Público Blog</option>
            <option value="vis_privado">🔒 Privado</option>
          </select>
          <button onclick="resetAllFilters()" title="Limpiar todos los filtros"
                  class="px-2.5 py-2 rounded-lg bg-obsidian hover:bg-elevated border border-borderTech text-xs font-mono text-slate-400 hover:text-white shrink-0">
            Reset
          </button>
        </div>
      </div>

      <!-- Barra de Filtro Rápido por Proyecto Aplicado -->
      <div class="flex items-center gap-2 overflow-x-auto pb-0.5" id="projects-cloud"></div>
    </div>
  </section>

  <!-- ======================================================================== -->
  <!-- TABLERO DE EXPEDIENTES                                                   -->
  <!-- ======================================================================== -->
  <main class="flex-1 max-w-[1680px] w-full mx-auto px-4 lg:px-6 py-6">
    
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <p id="results-summary" class="text-xs text-slate-400 font-mono">Mostrando todos los expedientes</p>
      <button onclick="openRestoreDefaultsModal()" class="text-[11px] font-mono text-slate-500 hover:text-amberSurgical transition">
        ↺ Restaurar catálogo base v3.0
      </button>
    </div>

    <div id="assets-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"></div>

    <div id="empty-state" class="hidden py-20 text-center border border-dashed border-borderTech rounded-xl bg-panel/40">
      <p class="text-sm font-bold text-slate-300">No hay fichas que coincidan con los filtros seleccionados</p>
      <p class="text-xs text-slate-500 mt-1">Prueba limpiar los filtros o crea una nueva ficha desde "+ Captura Rápida".</p>
      <button onclick="resetAllFilters()" class="mt-4 px-4 py-2 rounded-lg bg-panel hover:bg-elevated border border-borderTech text-xs font-semibold text-tealSurgical">
        Restablecer filtros
      </button>
    </div>
  </main>

  <!-- ======================================================================== -->
  <!-- MODAL 1: + CAPTURA RÁPIDA (FAST-CAPTURE)                                 -->
  <!-- ======================================================================== -->
  <div id="modal-fast-capture" class="hidden fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4">
    <div class="bg-panel border border-borderTech rounded-xl w-full max-w-md shadow-2xl overflow-hidden">
      <div class="px-5 py-4 border-b border-borderTech flex items-center justify-between bg-obsidian/70">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amberSurgical"></span>
          <h2 class="text-sm font-bold text-white">Captura Rápida (Fast-Capture)</h2>
        </div>
        <button onclick="closeModal('modal-fast-capture')" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <form onsubmit="submitFastCapture(event)" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Nombre del Canal, Cliente, Proyecto Musical o Indicador *</label>
          <input type="text" id="fc-name" required placeholder="Ej: Nuevo Canal IA / Clínica Dental / Skill Auditoría"
                 class="w-full px-3.5 py-2.5 rounded-lg bg-obsidian border border-borderTech focus:border-amberSurgical focus:outline-none text-xs text-white" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Vertical Destino *</label>
          <select id="fc-vertical" onchange="toggleFastCaptureIndicatorFields()" required
                  class="w-full px-3.5 py-2.5 rounded-lg bg-obsidian border border-borderTech focus:border-amberSurgical focus:outline-none text-xs text-white">
            <option value="canales">1. Canales de Contenido</option>
            <option value="clientes">2. Clientes, Diseño & Web</option>
            <option value="musica_audio">3. Música & Audio (Sonido Decrépito)</option>
            <option value="indicadores">4. INDICADORES (Códice, Skill, Habilidad, Prompt)</option>
          </select>
        </div>

        <!-- Campos rápidos exclusivos si elige INDICADORES -->
        <div id="fc-indicator-extra" class="hidden grid grid-cols-2 gap-3 p-3 rounded-lg bg-obsidian border border-violetInd/35">
          <div>
            <label class="block text-[11px] font-mono text-violetInd mb-1">TIPO DE INDICADOR</label>
            <select id="fc-ind-type" class="w-full px-2.5 py-2 rounded bg-panel border border-borderTech text-xs text-white">
              <option value="Códice">Códice</option>
              <option value="Skill">Skill</option>
              <option value="Habilidad">Habilidad</option>
              <option value="Prompt">Prompt</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-mono text-violetInd mb-1">MODELO IA EJECUTADO</label>
            <input type="text" id="fc-ind-model" value="Gemini 2.5 Pro" class="w-full px-2.5 py-2 rounded bg-panel border border-borderTech text-xs text-white" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Usado para (Función)</label>
            <input type="text" id="fc-function" value="Guionización" placeholder="Ej: Investigación Forense"
                   class="w-full px-3 py-2 rounded-lg bg-obsidian border border-borderTech text-xs text-slate-200" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">Titularidad</label>
            <select id="fc-ownership" class="w-full px-3 py-2 rounded-lg bg-obsidian border border-borderTech text-xs text-slate-200">
              <option value="mio">🔑 Propiedad Mía / Agencia</option>
              <option value="cliente">🤝 Propiedad del Cliente</option>
            </select>
          </div>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2">
          <button type="button" onclick="closeModal('modal-fast-capture')"
                  class="px-4 py-2 rounded-lg bg-obsidian hover:bg-elevated border border-borderTech text-xs text-slate-300">
            Cancelar
          </button>
          <button type="submit"
                  class="px-4 py-2 rounded-lg bg-amberSurgical hover:bg-amber-400 text-obsidian text-xs font-extrabold">
            Crear y Abrir Editor
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ======================================================================== -->
  <!-- MODAL 2: EDITOR MAESTRO CON "MOVER A: ___" Y SUB-PESTAÑAS ADAPTATIVAS    -->
  <!-- ======================================================================== -->
  <div id="modal-editor" class="hidden fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-2 sm:p-4">
    <div class="bg-panel border border-borderTech rounded-xl w-full max-w-5xl max-h-[94vh] flex flex-col shadow-2xl overflow-hidden">
      
      <!-- Cabecera del Editor con Acción Rápida "Mover a: ___" -->
      <div class="px-5 py-3.5 border-b border-borderTech flex flex-wrap items-center justify-between gap-3 bg-obsidian/85">
        <div>
          <span id="ed-subtitle" class="text-[10px] font-mono uppercase tracking-wider text-tealSurgical">EXPEDIENTE MAESTRO EDITABLE</span>
          <h2 id="ed-title" class="text-base font-extrabold text-white">Editar Ficha</h2>
        </div>

        <div class="flex items-center gap-2">
          <!-- Selector Universal Mover a: ___ dentro del Editor -->
          <div class="flex items-center gap-1.5 bg-panel px-2.5 py-1.5 rounded-lg border border-amberSurgical/40">
            <span class="text-[11px] font-mono text-amberSurgical font-bold">Mover a:</span>
            <select id="ed-move-vertical" onchange="handleMoveFromEditor(this.value)"
                    class="bg-obsidian border border-borderTech rounded px-2 py-1 text-xs font-semibold text-white focus:outline-none">
              <option value="canales">Canales de Contenido</option>
              <option value="clientes">Clientes, Diseño & Web</option>
              <option value="musica_audio">Música & Audio (Sonido Decrépito)</option>
              <option value="indicadores">INDICADORES (Códices/Skills)</option>
            </select>
          </div>

          <button onclick="closeModal('modal-editor')" class="w-8 h-8 rounded-lg bg-panel hover:bg-elevated border border-borderTech text-slate-400 hover:text-white flex items-center justify-center">
            ✕
          </button>
        </div>
      </div>

      <!-- Barra de Sub-pestañas del Editor -->
      <div class="px-5 pt-2.5 bg-obsidian/50 border-b border-borderTech flex flex-wrap gap-1.5">
        <button type="button" onclick="switchEditorTab('general')" id="ed-tab-general" class="ed-subtab px-3 py-2 rounded-t-lg text-xs font-bold border-t border-x transition">
