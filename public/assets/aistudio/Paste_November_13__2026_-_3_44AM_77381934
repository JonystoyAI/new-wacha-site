          `;
          grid.appendChild(w);
        });
        box.appendChild(grid);
      }

      rebuildExecutedPrompt();
      openModal('modal-execute');
    }

    function rebuildExecutedPrompt() {
      if (!currentExecutingAsset) return;
      const incStyle = document.getElementById('exec-inc-stylelock').checked;
      const incPrompt = document.getElementById('exec-inc-prompt').checked;
      const parts = [];
      if (incStyle && currentExecutingAsset.stylelock) {
        parts.push(`[STYLE LOCK — ${currentExecutingAsset.name.toUpperCase()}]\n${currentExecutingAsset.stylelock}`);
      }
      if (incPrompt && currentExecutingAsset.prompt) {
        parts.push(currentExecutingAsset.prompt);
      }
      let out = parts.join('\n\n---\n\n');
      document.querySelectorAll('.exec-var-input').forEach(inp => {
        const val = inp.value.trim();
        if (val) out = out.replace(new RegExp(`\\{\\{${inp.dataset.var}\\}\\}`, 'g'), val);
      });
      document.getElementById('exec-output').value = out;
      document.getElementById('exec-char-count').textContent = `${out.length} caracteres`;
    }

    function copyExecutedPrompt() {
