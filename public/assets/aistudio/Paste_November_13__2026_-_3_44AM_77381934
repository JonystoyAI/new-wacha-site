        assetId: item.id,
        previousState: JSON.parse(JSON.stringify(item)),
        fromLabel: VERTICAL_NAMES[previousVertical] || previousVertical,
        toLabel: VERTICAL_NAMES[targetVertical] || targetVertical
      };

