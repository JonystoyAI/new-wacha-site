    function downloadLogoByAssetId(assetId, type) {
      const entry = logosCache[assetId];
      const item = assets.find(a => a.id === assetId);
      const slug = slugify(item ? item.name : 'logo');
      if (!entry) return;
      if (type === 'png' && entry.png) {
        const a = document.createElement('a');
        a.href = entry.png;
        a.download = `${slug}-logo.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } else if (type === 'svg' && entry.svg) {
        triggerDownload(entry.svg, `${slug}-logo.svg`, 'image/svg+xml');
      }
    }

