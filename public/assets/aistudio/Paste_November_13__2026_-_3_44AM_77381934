    }

    function openBlogHubModal(preselectId = null) {
      const selector = document.getElementById('blog-asset-selector');
      selector.innerHTML = '';
      const sorted = [...assets].sort((a, b) => (b.visibility === 'publico') - (a.visibility === 'publico'));
      sorted.forEach(a => {
        const opt = document.createElement('option');
        opt.value = a.id;
        opt.textContent = `${a.visibility === 'publico' ? '🌐' : '🔒'} ${a.name}`;
        if (preselectId && a.id === preselectId) opt.selected = true;
        selector.appendChild(opt);
      });
      renderBlogPreview();
      openModal('modal-blog');
    }

    function getSelectedBlogAsset() {
      return assets.find(a => a.id === document.getElementById('blog-asset-selector').value) || null;
    }

    function renderBlogPreview() {
      const item = getSelectedBlogAsset();
      const card = document.getElementById('blog-preview-card');
      if (!item) return;
      const c = getSanitizedPublicObject(item);

      card.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-borderTech pb-3">
          <div>
            <span class="text-[11px] font-mono text-emeraldOk">${c.vertical} ${c.tipo_indicador ? `• ${c.tipo_indicador}` : ''} • ${c.funcion}</span>
            <h3 class="text-lg font-extrabold text-white mt-0.5">${c.titulo}</h3>
          </div>
          <div class="flex gap-1.5">
            ${c.paleta_hex.map(h => `<span class="px-2 py-0.5 rounded text-[10px] font-mono border border-white/10" style="background:${h};color:#fff;text-shadow:0 1px 2px #000">${h}</span>`).join('')}
          </div>
        </div>
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-1">Guía de Uso</h4>
          <p class="text-xs text-slate-300 leading-relaxed">${c.guia_de_uso}</p>
        </div>
        ${c.style_lock_visual ? `
          <div>
            <h4 class="text-xs font-mono font-bold text-tealSurgical mb-1">Style Lock Visual</h4>
            <pre class="p-3 rounded-lg bg-panel border border-borderTech text-xs font-mono text-slate-200 whitespace-pre-wrap">${c.style_lock_visual}</pre>
          </div>` : ''}
        ${c.cuerpo_indicador ? `
          <div>
            <h4 class="text-xs font-mono font-bold text-amberSurgical mb-1">Indicador / Prompt</h4>
            <pre class="p-3 rounded-lg bg-panel border border-borderTech text-xs font-mono text-slate-200 whitespace-pre-wrap">${c.cuerpo_indicador}</pre>
          </div>` : ''}
      `;
    }

    function downloadCleanBlogMarkdown() {
      const item = getSelectedBlogAsset();
      if (!item) return;
      const c = getSanitizedPublicObject(item);
      const md = [
        `# ${c.titulo}`,
        `**Sección:** ${c.vertical} | **Función:** ${c.funcion}${c.modelo_ia ? ` | **Modelo IA:** ${c.modelo_ia}` : ''}`,
        '',
        '## Guía de Uso',
        c.guia_de_uso,
        c.style_lock_visual ? `\n## Style Lock Visual\n\`\`\`text\n${c.style_lock_visual}\n\`\`\`` : '',
        c.cuerpo_indicador ? `\n## Indicador / Prompt\n\`\`\`text\n${c.cuerpo_indicador}\n\`\`\`` : ''
      ].filter(Boolean).join('\n');
      triggerDownload(md, `${slugify(c.titulo)}-blog.md`, 'text/markdown');
      showToast('Markdown sanitizado descargado');
    }

    function downloadCleanBlogJson() {
      const item = getSelectedBlogAsset();
      if (!item) return;
      const c = getSanitizedPublicObject(item);
      triggerDownload(JSON.stringify(c, null, 2), `${slugify(c.titulo)}-blog.json`, 'application/json');
      showToast('JSON sanitizado descargado');
    }

    function copyBlogHtmlEmbed() {
      const item = getSelectedBlogAsset();
      if (!item) return;
      const c = getSanitizedPublicObject(item);
      const html = `<!-- NEXUS STUDIO OS v3.0 — EMBED SANITIZADO -->
<section style="background:#0B0E14;color:#E2E8F0;border:1px solid #232D3F;border-radius:12px;padding:24px;font-family:system-ui,sans-serif;max-width:820px;margin:24px auto;">
  <div style="font-size:12px;color:#14B8A6;font-family:monospace;margin-bottom:6px;">${c.vertical} • ${c.funcion}</div>
  <h3 style="margin:0 0 12px 0;font-size:20px;color:#FFFFFF;">${c.titulo}</h3>
  <p style="font-size:14px;line-height:1.6;color:#CBD5E1;margin-bottom:16px;">${c.guia_de_uso}</p>
  ${c.style_lock_visual ? `<div style="margin-bottom:14px;"><strong style="font-size:12px;color:#14B8A6;font-family:monospace;">STYLE LOCK:</strong><pre style="background:#121722;border:1px solid #232D3F;padding:12px;border-radius:8px;white-space:pre-wrap;font-size:12px;color:#F8FAFC;">${c.style_lock_visual}</pre></div>` : ''}
  ${c.cuerpo_indicador ? `<div><strong style="font-size:12px;color:#F59E0B;font-family:monospace;">INDICADOR IA:</strong><pre style="background:#121722;border:1px solid #232D3F;padding:12px;border-radius:8px;white-space:pre-wrap;font-size:12px;color:#F8FAFC;">${c.cuerpo_indicador}</pre></div>` : ''}
</section>`;
      copyText(html, 'HTML Embed sanitizado copiado para tu blog');
    }

    // ==========================================================================
    // 10. UTILIDADES Y NOTIFICACIONES (CON TOAST UNDO)
    // ==========================================================================
    function copyText(text, msg = 'Copiado') {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast(msg);
    }

    function triggerDownload(content, filename, mime) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function slugify(str) {
      return (str || 'ficha').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

    function openConfirmDialog(title, message, onConfirm) {
      document.getElementById('confirm-title').textContent = title;
      document.getElementById('confirm-message').textContent = message;
      document.getElementById('confirm-action-btn').onclick = () => {
        closeModal('modal-confirm');
        onConfirm();
      };
      openModal('modal-confirm');
    }

    function showToast(msg, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const cls = type === 'error' ? 'border-crimsonAlert/60 text-crimsonAlert' : 'border-tealSurgical/60 text-white';
      toast.className = `px-4 py-2.5 rounded-lg bg-panel border ${cls} shadow-2xl text-xs font-semibold flex items-center gap-2 transition-opacity duration-200`;
      toast.innerHTML = `<span class="w-2 h-2 rounded-full ${type === 'error' ? 'bg-crimsonAlert' : 'bg-tealSurgical'}"></span><span>${msg}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 220);
      }, 2800);
    }

    function showUndoToast(msg, onUndo) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'px-4 py-2.5 rounded-lg bg-panel border border-amberSurgical shadow-2xl text-xs font-semibold text-white flex items-center gap-3 transition-opacity duration-200';
      toast.innerHTML = `
        <span class="w-2 h-2 rounded-full bg-amberSurgical"></span>
        <span>${msg}</span>
        <button type="button" class="px-2.5 py-1 rounded bg-amberSurgical text-obsidian font-extrabold text-[11px] hover:bg-amber-400">
          Deshacer
        </button>
      `;
      toast.querySelector('button').onclick = () => {
        onUndo();
        toast.remove();
      };
      container.appendChild(toast);
      setTimeout(() => {
        if (toast.parentNode) {
          toast.style.opacity = '0';
          setTimeout(() => toast.remove(), 220);
        }
      }, 5500);
    }

    window.onload = async function () {
      await initIndexedDB();
      loadAssets();
      setFilterVertical('all');
    };
  </script>
</body>
</html>