    function extractVariables(text) {
      if (!text) return [];
      const regex = /\{\{([A-Z0-9_]+)\}\}/g;
      const set = new Set();
      let m;
      while ((m = regex.exec(text)) !== null) set.add(m[1]);
      return Array.from(set);
    }

    function openExecuteModal(id) {
      const item = assets.find(a => a.id === id);
      if (!item) return;
      currentExecutingAsset = item;

      document.getElementById('exec-title').textContent = item.name;
      const chkStyle = document.getElementById('exec-inc-stylelock');
      const chkPrompt = document.getElementById('exec-inc-prompt');
      chkStyle.checked = Boolean(item.stylelock);
      chkStyle.disabled = !item.stylelock;
      chkPrompt.checked = Boolean(item.prompt);
      chkPrompt.disabled = !item.prompt;

      const vars = extractVariables(`${item.stylelock || ''}\n${item.prompt || ''}`);
      const box = document.getElementById('exec-variables-container');
      box.innerHTML = '';

      if (vars.length === 0) {
        box.innerHTML = `<div class="p-3 rounded-lg bg-obsidian border border-borderTech text-xs text-slate-400">Este bloque no requiere variables <code class="text-amberSurgical">{{...}}</code>. Puedes copiar el resultado ensamblado directamente.</div>`;
      } else {
        box.innerHTML = `<div class="text-xs font-bold text-amberSurgical mb-2">Variables detectadas (${vars.length}):</div>`;
        const grid = document.createElement('div');
        grid.className = 'grid grid-cols-1 sm:grid-cols-2 gap-3';
        vars.forEach(v => {
          const w = document.createElement('div');
          w.innerHTML = `
            <label class="block text-[11px] font-mono text-amberSurgical mb-1">{{${v}}}</label>
            <input type="text" data-var="${v}" oninput="rebuildExecutedPrompt()" placeholder="Ingresa ${v}..."
