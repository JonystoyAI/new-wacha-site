      const projSet = new Set();
      assets.forEach(a => {
        if (a.vertical !== 'indicadores') projSet.add(a.name);
        if (a.indicatorMeta && Array.isArray(a.indicatorMeta.projects)) {
          a.indicatorMeta.projects.forEach(p => { if (p.trim()) projSet.add(p.trim()); });
        }
      });

      const cloud = document.getElementById('projects-cloud');
      cloud.innerHTML = `<span class="text-[11px] font-mono text-slate-500 shrink-0 mr-1">Filtrar por Proyecto:</span>`;
      Array.from(projSet).slice(0, 14).forEach(proj => {
        const active = currentProjectPill === proj;
        const btn = document.createElement('button');
        btn.onclick = () => toggleProjectPill(proj);
        btn.className = active
          ? 'px-2.5 py-1 rounded-md text-[11px] font-mono bg-amberSurgical text-obsidian font-bold shrink-0 transition'
          : 'px-2.5 py-1 rounded-md text-[11px] font-mono bg-obsidian hover:bg-elevated border border-borderTech text-slate-400 hover:text-slate-200 shrink-0 transition';
        btn.textContent = proj;
        cloud.appendChild(btn);
      });
    }

    function getVerticalVisualStyle(v) {
      switch (v) {
        case 'canales':
          return { label: 'Canal de Contenido', cls: 'text-tealSurgical bg-tealSurgical/10 border-tealSurgical/30' };
        case 'clientes':
          return { label: 'Cliente, Diseño & Web', cls: 'text-amberSurgical bg-amberSurgical/10 border-amberSurgical/30' };
        case 'musica_audio':
          return { label: 'Música & Audio', cls: 'text-roseAudio bg-roseAudio/10 border-roseAudio/30' };
        case 'indicadores':
          return { label: 'INDICADOR IA', cls: 'text-violetInd bg-violetInd/10 border-violetInd/30' };
        default:
          return { label: v, cls: 'text-slate-300 bg-slate-800 border-slate-700' };
      }
    }

    function highlightVars(text) {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\{\{([A-Z0-9_]+)\}\}/g, '<span class="var-token">{{$1}}</span>');
    }

    function renderWorkspace() {
      updateStatsAndProjectPills();
      const q = document.getElementById('global-search').value.trim().toLowerCase();
      document.getElementById('clear-search-btn').classList.toggle('hidden', q.length === 0);

      const indTypeFilter = document.getElementById('filter-ind-type').value;
      const funcFilter = document.getElementById('filter-function').value;
      const aiModelFilter = document.getElementById('filter-ai-model').value;
      const ownerFilter = document.getElementById('filter-ownership').value;

      const filtered = assets.filter(item => {
        if (currentVertical !== 'all' && item.vertical !== currentVertical) return false;

        if (indTypeFilter !== 'all') {
          if (item.vertical !== 'indicadores') return false;
          if ((item.indicatorMeta?.type || '') !== indTypeFilter) return false;
        }

        if (funcFilter !== 'all') {
          const itemFunc = (item.indicatorMeta?.usedFor || item.func || '').toLowerCase();
          if (!itemFunc.includes(funcFilter.toLowerCase())) return false;
        }

        if (aiModelFilter !== 'all') {
          const indModel = (item.indicatorMeta?.aiModel || '').toLowerCase();
          const tools = (item.aiTools || []).map(t => t.toLowerCase());
          if (!indModel.includes(aiModelFilter.toLowerCase()) && !tools.some(t => t.includes(aiModelFilter.toLowerCase()))) {
            return false;
          }
        }

        if (ownerFilter === 'owner_mio' && item.ownership !== 'mio') return false;
        if (ownerFilter === 'owner_cliente' && item.ownership !== 'cliente') return false;
        if (ownerFilter === 'vis_publico' && item.visibility !== 'publico') return false;
        if (ownerFilter === 'vis_privado' && item.visibility !== 'privado') return false;

        if (currentProjectPill) {
          const matchesName = item.name.toLowerCase() === currentProjectPill.toLowerCase();
          const matchesIndProj = (item.indicatorMeta?.projects || []).some(p => p.toLowerCase() === currentProjectPill.toLowerCase());
          if (!matchesName && !matchesIndProj) return false;
        }

        if (q) {
          const blob = JSON.stringify(item).toLowerCase();
          if (!blob.includes(q)) return false;
        }
        return true;
      });

